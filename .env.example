# Copy to .env locally. Never commit populated secrets.
NODE_ENV=development
PORT=8080
# Public Firebase web configuration ONLY. Set before building Firebase Hosting assets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sdg8-4fca4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sdg8-4fca4
VITE_FIREBASE_STORAGE_BUCKET=sdg8-4fca4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=716301157311
VITE_FIREBASE_APP_ID=1:716301157311:web:0257c71d0cfc6bbba0170a
VITE_DEMO_MODE=true
# Optional Admin credentials for linking pre-existing users by email, not required
# for normal signed-token verification against Google's public certificates.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_CREDENTIALS_JSON=
# true enables revoked/disabled-user checks and requires privileged Admin access.
FIREBASE_CHECK_REVOKED=false
# Application DATA only. Never prefix these credentials with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative used by this demo: Firebase-authenticated gateway; no local server key.
SUPABASE_GATEWAY_URL=https://sdgdmplwvtplvtcndusy.supabase.co/functions/v1/bb-data
SUPABASE_PUBLISHABLE_KEY=
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
# Enable email selectors in a synthetic-data demo. Passwords are NEVER sent via config.
DEMO_MODE=true
